ANTHROPIC_API_KEY=

# Server (loopback only; expose it with `tailscale serve`, never by binding wider)
MEALPLANNER_HOST=127.0.0.1
MEALPLANNER_PORT=8000
MEALPLANNER_DATA_DIR=./data
MEALPLANNER_MODEL=claude-sonnet-4-5
# Comma-separated extra Host header values the app accepts (for example your tailnet name)
MEALPLANNER_ALLOWED_HOSTS=

# Access control (ADR 0012)
# Your Tailscale login (user 1). Required unless MEALPLANNER_DEV_LOGIN is set.
MEALPLANNER_OWNER_LOGIN=
# Local development only, to use http://127.0.0.1:8000 without Tailscale. Used only when the
# Tailscale-User-Login header is absent. Never set it while serving with `tailscale serve`.
MEALPLANNER_DEV_LOGIN=
